{
  "name": "@obsidiane/meridiane-sandbox",
  "displayName": "Meridiane Playground",
  "version": "0.0.0",
  "description": "Playground Foundation pour le bridge Meridiane local.",
  "homepage": "https://github.com/obsidiane-lab/foundation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidiane-lab/foundation.git"
  },
  "keywords": [
    "foundation",
    "obsidiane",
    "angular",
    "spartan-ui",
    "tailwind",
    "starter-kit",
    "tailwind-template",
    "dark mode",
    "open source"
  ],
  "author": "Obsidiane",
  "license": "0BSD",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prettier": "prettier --config ./.prettierrc --write \"src/**/*.{ts,html,css}\" \"src/assets/i18n/*.json\" .postcssrc.json .prettierrc angular.json components.json eslint.config.js package.json tsconfig.app.json tsconfig.json",
    "prettier:verify": "prettier --config ./.prettierrc --check \"src/**/*.{ts,html,css}\" \"src/assets/i18n/*.json\" .postcssrc.json .prettierrc angular.json components.json eslint.config.js package.json tsconfig.app.json tsconfig.json",
    "lint": "ng lint",
    "bridge:sync": "node ../../packages/meridiane/cli.js generate @app/bridge --version 0.0.0-dev --spec ../core/var/openapi.json --out bridge",
    "dev": "ng serve --host 0.0.0.0 --port 4200"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.4",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@ngx-translate/core": "^18.0.0",
    "@spartan-ng/brain": "^1.8.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.7.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "^1.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "angular-eslint": "22.6.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.13.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
