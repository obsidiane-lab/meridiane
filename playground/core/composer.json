{
    "type": "project",
    "license": "0BSD",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "api-platform/doctrine-orm": "5.0.*",
        "api-platform/symfony": "5.0.*",
        "doctrine/dbal": "4.5.*",
        "doctrine/doctrine-bundle": "3.3.*",
        "doctrine/orm": "3.7.*",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "nelmio/cors-bundle": "2.6.*",
        "php": ">=8.5",
        "phpdocumentor/reflection-docblock": "6.0.*",
        "phpstan/phpdoc-parser": "2.3.*",
        "symfony/asset": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/expression-language": "8.1.*",
        "symfony/flex": "2.11.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/mercure": "^0.9.0",
        "symfony/mercure-bundle": "^0.6.1",
        "symfony/property-access": "8.1.*",
        "symfony/property-info": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "8.1.*"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3.1",
        "symfony/maker-bundle": "^1.68.0"
    }
}
