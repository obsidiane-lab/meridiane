{
  "name": "@obsidiane/meridiane-workspace",

  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "playground/*"
  ],
  "scripts": {
    "playground:bridge": "npm -w @obsidiane/meridiane-sandbox run bridge:sync",
    "playground:build": "npm -w @obsidiane/meridiane-sandbox run build",
    "playground:dev": "npm -w @obsidiane/meridiane-sandbox run dev",
    "sandbox:bridge": "npm -w @obsidiane/meridiane-sandbox run bridge:sync",
    "sandbox:build": "npm -w @obsidiane/meridiane-sandbox run build",
    "sandbox:dev": "npm -w @obsidiane/meridiane-sandbox run dev"
  },
  "dependencies": {
    "commander": "^14.0.3"
  }
}
