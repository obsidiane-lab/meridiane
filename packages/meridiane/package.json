{
  "name": "@obsidiane/meridiane",
  "version": "3.0.0",
  "description": "Générateur de librairie Angular et modèles TypeScript (OpenAPI) pour un bridge Symfony/API Platform + Mercure.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obsidiane-lab/meridiane.git"
  },
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "pack:check": "npm_config_cache=./.npm-cache npm pack --dry-run"
  },
  "bin": {
    "meridiane": "cli.js"
  },
  "files": [
    "cli.js",
    "src/**",
    "templates/**",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@angular/common": "20.3.29",
    "@angular/compiler": "20.3.29",
    "@angular/compiler-cli": "20.3.29",
    "@angular/core": "20.3.29",
    "commander": "^14.0.3",
    "handlebars": "^4.7.9",
    "ng-packagr": "20.3.2",
    "rxjs": "7.8.2",
    "tslib": "^2.8.1",
    "typescript": "5.9.3"
  }
}
